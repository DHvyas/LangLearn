[
  { "id": "s01", "emoji": "👋", "english": "How are you?",
    "gu": { "roman": "Kem cho?", "script": "કેમ છો?" },
    "bn": { "roman": "Kemon acho?", "script": "কেমন আছো?" },
    "note": "Almost twins! Both come from the same root 'kemon' (how). Gujarati 'cho' and Bengali 'acho' both mean 'are'." },
  { "id": "s02", "emoji": "😊", "english": "I'm doing well",
    "gu": { "roman": "Hu majama chu", "script": "હું મજામાં છું" },
    "bn": { "roman": "Ami bhalo achi", "script": "আমি ভালো আছি" },
    "note": "Gujarati 'majama' literally means 'in fun', so you're saying 'I'm having fun'. Bengali 'bhalo' means 'good'." },
  { "id": "s03", "emoji": "🙏", "english": "Thank you",
    "gu": { "roman": "Aabhar", "script": "આભાર" },
    "bn": { "roman": "Dhonnobad", "script": "ধন্যবাদ" },
    "note": "In both families, thanking close relatives can sound oddly formal. A smile often does the job instead." },
  { "id": "s04", "emoji": "❤️", "english": "I love you",
    "gu": { "roman": "Hu tane prem karu chu", "script": "હું તને પ્રેમ કરું છું" },
    "bn": { "roman": "Ami tomake bhalobashi", "script": "আমি তোমাকে ভালোবাসি" },
    "note": "Bengali 'bhalobasha' (love) is literally 'good dwelling', as in love is where you feel at home." },
  { "id": "s05", "emoji": "🥺", "english": "I miss you",
    "gu": { "roman": "Mane tari yaad aave chhe", "script": "મને તારી યાદ આવે છે" },
    "bn": { "roman": "Tomar kotha mone porche", "script": "তোমার কথা মনে পড়ছে" },
    "note": "Neither language 'misses' anyone directly. Gujarati: 'your memory comes to me'. Bengali: 'thoughts of you fall into my mind'." },
  { "id": "s06", "emoji": "🍛", "english": "Have you eaten?",
    "gu": { "roman": "Jamyu?", "script": "જમ્યું?" },
    "bn": { "roman": "Kheyecho?", "script": "খেয়েছো?" },
    "note": "The real 'I love you' of every Indian mom, Gujarati or Bengali." },
  { "id": "s07", "emoji": "🌙", "english": "Good night",
    "gu": { "roman": "Shubh ratri", "script": "શુભ રાત્રિ" },
    "bn": { "roman": "Shubho ratri", "script": "শুভ রাত্রি" },
    "note": "Same Sanskrit roots. Bengali just adds its signature 'o' sound at the end." },
  { "id": "s08", "emoji": "☀️", "english": "Good morning",
    "gu": { "roman": "Suprabhat", "script": "સુપ્રભાત" },
    "bn": { "roman": "Shubho sokal", "script": "শুভ সকাল" },
    "note": "Bengali 'sokal' means morning. Gujarati 'prabhat' means dawn, and 'su-' means good." },
  { "id": "s09", "emoji": "🤔", "english": "What are you doing?",
    "gu": { "roman": "Shu kare chhe?", "script": "શું કરે છે?" },
    "bn": { "roman": "Ki korcho?", "script": "কী করছো?" },
    "note": "Perfect for the 'just checking in' text." },
  { "id": "s10", "emoji": "🚶", "english": "Let's go!",
    "gu": { "roman": "Chalo, jaiye!", "script": "ચાલો, જઈએ!" },
    "bn": { "roman": "Cholo, jai!", "script": "চলো, যাই!" },
    "note": "'Chalo' and 'cholo' are the same word. Notice how Bengali turns many 'a' sounds into 'o'." },
  { "id": "s11", "emoji": "😋", "english": "This is amazing!",
    "gu": { "roman": "Bahu mast chhe!", "script": "બહુ મસ્ત છે!" },
    "bn": { "roman": "Darun hoyeche!", "script": "দারুণ হয়েছে!" },
    "note": "'Darun' is the Bengali word for anything great: food, films, outfits. Gujaratis use 'mast' the same way." },
  { "id": "s12", "emoji": "🍽️", "english": "I'm hungry",
    "gu": { "roman": "Mane bhukh lagi chhe", "script": "મને ભૂખ લાગી છે" },
    "bn": { "roman": "Amar khide peyeche", "script": "আমার খিদে পেয়েছে" },
    "note": "In both languages hunger happens to you: 'hunger has struck me'." },
  { "id": "s13", "emoji": "😔", "english": "Sorry",
    "gu": { "roman": "Maaf karjo", "script": "માફ કરજો" },
    "bn": { "roman": "Dukkhito", "script": "দুঃখিত" },
    "note": "Gujarati 'maaf karjo' is 'please forgive'. Bengali 'dukkhito' literally means 'saddened'." },
  { "id": "s14", "emoji": "👀", "english": "See you later",
    "gu": { "roman": "Pachhi malie", "script": "પછી મળીએ" },
    "bn": { "roman": "Pore dekha hobe", "script": "পরে দেখা হবে" },
    "note": "Bengali says 'there will be a seeing later'. Gujarati says 'let's meet later'." },
  { "id": "s15", "emoji": "✨", "english": "You look beautiful",
    "gu": { "roman": "Tu bahu sundar lage chhe", "script": "તું બહુ સુંદર લાગે છે" },
    "bn": { "roman": "Tomake khub shundor lagche", "script": "তোমাকে খুব সুন্দর লাগছে" },
    "note": "'Sundar' and 'shundor' are the same word, the Bengali one just has the 'sh' and 'o' flavour." },
  { "id": "s16", "emoji": "🫂", "english": "Don't worry",
    "gu": { "roman": "Chinta na kar", "script": "ચિંતા ન કર" },
    "bn": { "roman": "Chinta koro na", "script": "চিন্তা কোরো না" },
    "note": "'Chinta' (worry) is shared. Both put the 'don't' near the verb." },
  { "id": "s17", "emoji": "😮", "english": "What happened?",
    "gu": { "roman": "Shu thayu?", "script": "શું થયું?" },
    "bn": { "roman": "Ki holo?", "script": "কী হলো?" },
    "note": "Gujarati 'shu' and Bengali 'ki' both mean 'what'." },
  { "id": "s18", "emoji": "😴", "english": "I'm sleepy",
    "gu": { "roman": "Mane ungh aave chhe", "script": "મને ઊંઘ આવે છે" },
    "bn": { "roman": "Amar ghum pacche", "script": "আমার ঘুম পাচ্ছে" },
    "note": "Sleep 'comes' to you in Gujarati. In Bengali you 'get' sleep." },
  { "id": "s19", "emoji": "👍", "english": "Yes / No",
    "gu": { "roman": "Haa / Na", "script": "હા / ના" },
    "bn": { "roman": "Hyan / Na", "script": "হ্যাঁ / না" },
    "note": "'Na' is the same in both. Easy win!" },
  { "id": "s20", "emoji": "💸", "english": "How much is this?",
    "gu": { "roman": "Aa ketla nu chhe?", "script": "આ કેટલાનું છે?" },
    "bn": { "roman": "Eta koto?", "script": "এটা কত?" },
    "note": "Essential for New Market in Kolkata and Law Garden in Ahmedabad." },
  { "id": "s21", "emoji": "🏠", "english": "Come here",
    "gu": { "roman": "Ahiya aav", "script": "અહીંયા આવ" },
    "bn": { "roman": "Ekhane esho", "script": "এখানে এসো" },
    "note": "Use this informal form with each other. With elders it's 'aavo' (Gujarati) and 'ashun' (Bengali)." },
  { "id": "s22", "emoji": "🫶", "english": "I'm so happy",
    "gu": { "roman": "Hu bahu khush chu", "script": "હું બહુ ખુશ છું" },
    "bn": { "roman": "Ami khub khushi", "script": "আমি খুব খুশি" },
    "note": "'Bahu' (Gujarati) and 'khub' (Bengali) both mean 'very'. You'll hear them constantly." }
]
